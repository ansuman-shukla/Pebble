# Backend settings, read from the repo-root .env (one .env for the whole repo; docker compose reads it too).
# Every value has a local default in app/core/config.py, so these are only needed to override.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5544
POSTGRES_USER=pebble
POSTGRES_PASSWORD=pebble
POSTGRES_DB=pebble
FRONTEND_ORIGINS=["http://localhost:5180"]
