            }
          }
        }
      }
    },
    "/api/v1/world": {
      "get": {
        "tags": [
          "world"
        ],
        "summary": "Read World",
        "description": "The planet: grid, heights, biomes, rivers, land loop and sites (stored JSON, generated on first request).",
        "operationId": "world-read_world",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorldView"
                }
              }
            }
          }
        }
      }
    }
  },
