{
  "openapi": "3.1.0",
  "info": {
    "title": "Pebble",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Read Health",
        "operationId": "health-read_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/town": {
      "get": {
        "tags": [
          "town"
        ],
        "summary": "Read Town",
        "operationId": "town-read_town",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TownView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/world": {
      "get": {
        "tags": [
          "world"
        ],
        "summary": "Read World",
        "description": "The planet: grid, heights, biomes, rivers, land loop and sites (stored JSON, generated on first request).",
        "operationId": "world-read_world",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorldView"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Anchor": {
        "properties": {
          "position": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "title": "Position"
          },
          "east": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "title": "East"
          },
          "north": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "title": "North"
          },
          "height_m": {
            "type": "number",
            "title": "Height M"
          }
        },
        "type": "object",
        "required": [
          "position",
          "east",
          "north",
          "height_m"
        ],
        "title": "Anchor"
      },
      "Extent": {
        "properties": {
          "min_x": {
            "type": "number",
            "title": "Min X"
          },
          "max_x": {
            "type": "number",
            "title": "Max X"
          },
          "min_z": {
            "type": "number",
            "title": "Min Z"
          },
          "max_z": {
            "type": "number",
            "title": "Max Z"
          }
        },
        "type": "object",
        "required": [
          "min_x",
          "max_x",
          "min_z",
          "max_z"
        ],
        "title": "Extent"
      },
      "Footprint": {
        "properties": {
          "x": {
            "type": "number",
            "title": "X"
          },
          "z": {
            "type": "number",
            "title": "Z"
          }
        },
        "type": "object",
        "required": [
          "x",
          "z"
        ],
        "title": "Footprint",
        "description": "Axis-aligned size after rotation."
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "database": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "HealthStatus"
      },
      "River": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "cells": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Cells"
          }
        },
        "type": "object",
        "required": [
          "id",
          "cells"
        ],
        "title": "River"
      },
      "Site": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "town",
              "camp",
              "landmark"
            ],
            "title": "Kind"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "cell": {
            "type": "integer",
            "title": "Cell"
          },
          "anchor": {
            "$ref": "#/components/schemas/Anchor"
          },
          "placements": {
            "items": {
              "$ref": "#/components/schemas/TownPlacement"
            },
            "type": "array",
            "title": "Placements",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "cell",
          "anchor"
        ],
        "title": "Site"
      },
      "Spawn": {
        "properties": {
          "x": {
            "type": "number",
            "title": "X"
          },
          "z": {
            "type": "number",
            "title": "Z"
          },
          "heading_deg": {
            "type": "number",
            "title": "Heading Deg"
          }
        },
        "type": "object",
        "required": [
          "x",
          "z",
          "heading_deg"
        ],
        "title": "Spawn"
      },
      "TownArea": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "street",
              "road",
              "plaza",
              "courtyard",
              "field"
            ],
            "title": "Kind"
          },
          "polygon": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "title": "Polygon"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "polygon"
        ],
        "title": "TownArea"
      },
      "TownCitizen": {
        "properties": {
          "look": {
            "type": "string",
            "title": "Look"
          },
          "x": {
            "type": "number",
            "title": "X"
          },
          "z": {
            "type": "number",
            "title": "Z"
          },
          "heading_deg": {
            "type": "number",
            "title": "Heading Deg"
          },
          "route": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "title": "Route",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "look",
          "x",
          "z",
          "heading_deg"
        ],
        "title": "TownCitizen"
      },
      "TownPlacement": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "x": {
            "type": "number",
            "title": "X"
          },
          "z": {
            "type": "number",
            "title": "Z"
          },
          "rotation_deg": {
            "type": "integer",
            "enum": [
              0,
              90,
              180,
              270
            ],
            "title": "Rotation Deg"
          },
          "footprint": {
            "$ref": "#/components/schemas/Footprint"
          },
          "walk": {
            "type": "string",
            "enum": [
              "solid",
              "surface",
              "none"
            ],
            "title": "Walk"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "x",
          "z",
          "rotation_deg",
          "footprint",
          "walk"
        ],
        "title": "TownPlacement"
      },
      "TownView": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "extent": {
            "$ref": "#/components/schemas/Extent"
          },
          "spawn": {
            "$ref": "#/components/schemas/Spawn"
          },
          "areas": {
            "items": {
              "$ref": "#/components/schemas/TownArea"
            },
            "type": "array",
            "title": "Areas"
          },
          "water": {
            "items": {
              "$ref": "#/components/schemas/TownWater"
            },
            "type": "array",
            "title": "Water"
          },
          "placements": {
            "items": {
              "$ref": "#/components/schemas/TownPlacement"
            },
            "type": "array",
            "title": "Placements"
          },
          "citizens": {
            "items": {
              "$ref": "#/components/schemas/TownCitizen"
            },
            "type": "array",
            "title": "Citizens"
          }
        },
        "type": "object",
        "required": [
          "name",
          "extent",
          "spawn",
          "areas",
          "water",
          "placements",
          "citizens"
        ],
        "title": "TownView"
      },
      "TownWater": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "moat",
              "stream"
            ],
            "title": "Kind"
          },
          "polygon": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "title": "Polygon"
          },
          "holes": {
            "items": {
              "items": {
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array",
                "maxItems": 2,
                "minItems": 2
              },
              "type": "array"
            },
            "type": "array",
            "title": "Holes",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "polygon"
        ],
        "title": "TownWater"
      },
      "WorldView": {
        "properties": {
          "seed": {
            "type": "integer",
            "title": "Seed"
          },
          "generator_version": {
            "type": "string",
            "title": "Generator Version"
          },
          "radius_m": {
            "type": "number",
            "title": "Radius M"
          },
          "frequency": {
            "type": "integer",
            "title": "Frequency"
          },
          "cell_count": {
            "type": "integer",
            "title": "Cell Count"
          },
          "biome_names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Biome Names"
          },
          "positions": {
            "type": "string",
            "title": "Positions"
          },
          "heights": {
            "type": "string",
            "title": "Heights"
          },
          "biomes": {
            "type": "string",
            "title": "Biomes"
          },
          "triangles": {
            "type": "string",
            "title": "Triangles"
          },
          "rivers": {
