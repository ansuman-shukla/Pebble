            "type": "array",
            "title": "Rivers"
          },
          "land_loop": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Land Loop"
          },
          "sites": {
            "items": {
              "$ref": "#/components/schemas/Site"
            },
            "type": "array",
            "title": "Sites"
          }
        },
        "type": "object",
        "required": [
          "seed",
          "generator_version",
          "radius_m",
          "frequency",
          "cell_count",
          "biome_names",
          "positions",
          "heights",
          "biomes",
          "triangles",
          "rivers",
          "land_loop",
          "sites"
