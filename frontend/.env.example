# Frontend settings, read from the repo-root .env (vite envDir is '..'). Only VITE_* values reach the browser.
# The browser calls /api on its own origin and vite proxies it to the backend, http://localhost:8100 by default
# (set PEBBLE_API_TARGET in the environment of `pnpm dev` / `pnpm preview` to change it).
# Optional: call the backend directly instead (its FRONTEND_ORIGINS must then allow the page's origin).
# VITE_API_URL=http://localhost:8100
